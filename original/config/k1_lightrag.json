{
  "version": "1.5.7",
  "synthetic_distractors": 9,
  "block_tokens": 500,
  "context_window": 16384,
  "timeout_seconds": 600,
  "role_output_tokens": {"extract": 4096, "keyword": 256, "query": 1024},
  "json_extraction": true,
  "gleaning": 1,
  "max_entities": 40,
  "max_records": 100,
  "summary_context_tokens": 4000,
  "summary_max_tokens": 500,
  "summary_recommended_tokens": 300,
  "embedding_token_limit": 8192,
  "embedding_batch_size": 16,
  "cosine_threshold": 0.2,
  "query_mode": "mix",
  "query_top_k": 40,
  "query_chunk_top_k": 20,
  "query_max_tokens": 6000,
  "query_entity_tokens": 2000,
  "query_relation_tokens": 2000
}
